# Copy to deploy/.env and fill in. Never commit the real file.

# The URL players use. Must match the domain your reverse proxy serves.
PUBLIC_URL=https://chessx.example.com

# Optional: Google sign-in (Google Cloud Console -> OAuth client, Web application).
# Authorised redirect URI: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Facebook sign-in (Meta for Developers -> Facebook Login).
# Valid OAuth redirect URI: ${PUBLIC_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
