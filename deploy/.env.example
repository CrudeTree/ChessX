# Copy to deploy/.env and fill in. Never commit the real file.

# The URL players use. Must match the domain your reverse proxy serves.
PUBLIC_URL=https://playchessx.com

# Port on the host (127.0.0.1) that the reverse proxy forwards to. Change if 8080 is busy.
HOST_PORT=8080

# Optional: Google sign-in (Google Cloud Console -> OAuth client, Web application).
# Authorised redirect URI: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Facebook sign-in (Meta for Developers -> Facebook Login).
# Valid OAuth redirect URI: ${PUBLIC_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Game admin (the in-app Card editor). The earliest account registered with this
# display name is pinned as admin the first time the server looks; later accounts
# with the same name get nothing. Extra admins: comma-separated user ids.
ADMIN_NAME=Djabooty
ADMIN_USER_IDS=
