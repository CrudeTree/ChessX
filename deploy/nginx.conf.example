# nginx site for ChessX. Drop into /etc/nginx/sites-available/chessx, symlink into
# sites-enabled, then `certbot --nginx -d chessx.example.com` for HTTPS.
# WebSockets need the Upgrade/Connection headers below.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name chessx.example.com;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Long-lived game sockets: do not time them out after 60s of silence.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
